ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://lexep:lexep@db:5432/lexep

CORS_ORIGINS=["http://localhost:3000"]

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Premium / monetization ---------------------------------------------
# Master switch for the whole paywall. Leave false to run Lexep entirely
# free while you build up an audience; flip to true when ready to charge.
PREMIUM_FEATURES_ENABLED=false

# --- Payments (Paystack) --------------------------------------------------
# Leave PAYMENTS_ENABLED=false to use a mock provider: checkout flows work
# end-to-end instantly with no external calls, so you can demo/test grant
# contributions and premium checkout without a Paystack account.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Email (Brevo) ---------------------------------------------------------
# Leave EMAIL_ENABLED=false to log emails instead of sending them.
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@lexep.org
EMAIL_FROM_NAME=Lexep

# --- SMS (Arkesel) -----------------------------------------------------------
# Leave SMS_ENABLED=false to log SMS instead of sending them.
SMS_ENABLED=false
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Lexep

# --- File storage (Supabase Storage) ----------------------------------------
# Leave SUPABASE_ENABLED=false to store uploads on local disk instead
# (fine for development; use Supabase or another object store in production).
# Note: this only affects file storage — auth stays on Lexep's own
# platform-agnostic JWT system either way.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=lexep-uploads
